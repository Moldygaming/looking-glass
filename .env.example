# Looking Glass local / container config
# Copy to .env and adjust. Do not commit real secrets.

# --- Core ---
APP_ENV=development
APP_SECRET=change-me-to-a-long-random-string
INTERNAL_API_KEY=change-me-internal-key

# Postgres (docker-compose default)
DATABASE_URL=postgresql+asyncpg://lookingglass:lookingglass@postgres:5432/lookingglass

# Blob / S3-compatible store for raw cost exports (Azurite locally)
BLOB_ENDPOINT=http://azurite:10000/devstoreaccount1
BLOB_ACCOUNT=devstoreaccount1
BLOB_KEY=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==
BLOB_CONTAINER=cost-exports

# API <-> web
API_URL=http://api:8000
WEB_ORIGIN=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=change-me-to-a-long-random-string

# --- Microsoft Entra ID SSO ---
# Redirect URI: http://localhost:3000/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=

# Entra security group object ID whose members become platform admins.
# Configure the app registration to emit group claims (security groups, Group ID).
ENTRA_ADMIN_GROUP_ID=

# Optional extra Entra group that may sign in before a portal role is assigned.
ENTRA_ACCESS_GROUP_ID=

# Optional app role value that also grants platform admin (token `roles` claim).
ENTRA_ADMIN_ROLE=PlatformAdmin

# Single local break-glass account. Defaults shown; override in production.
BREAK_GLASS_USERNAME=infraadmin
BREAK_GLASS_PASSWORD=admin123+

# Optional bootstrap for a first Entra tenant if Admin → Entra config is empty.
# Prefer adding tenants in the admin portal (supports multiple tenants).
# Grant application permissions with admin consent:
# User.ReadWrite.All, Group.ReadWrite.All, Directory.Read.All
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_SYNC_INTERVAL_SECONDS=3600
